# modernize-use-nullptr disabled due to https://github.com/llvm/llvm-project/issues/53778
# *-avoid-c-arrays disabled due to https://github.com/llvm/llvm-project/issues/132260
# performance-enum-size disabled due to https://github.com/llvm/llvm-project/issues/178114
# cppcoreguidelines-prefer-member-initializer disabled due to https://github.com/llvm/llvm-project/issues/52837
Checks: >
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  cert-*,
  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-init-variables,
  -cppcoreguidelines-macro-usage,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-prefer-member-initializer,
  -cppcoreguidelines-pro-type-member-init,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  misc-*,
  -misc-include-cleaner,
  -*-non-private-member-variables-in-classes,
  modernize-*,
  -*-avoid-c-arrays,
  -modernize-deprecated-headers,
  -*-macro-to-enum,
  -modernize-use-nullptr,
  -modernize-use-trailing-return-type,
  performance-*,
  -performance-enum-size,
  portability-*,
  readability-redundant-inline-specifier
HeaderFilterRegex: .*
ExcludeHeaderFilterRegex: '[\\/]_deps[\\/]'
CheckOptions:
  misc-header-include-cycle.IgnoredFilesList: '[\\/]_deps[\\/]'
  modernize-use-using.IgnoreExternC: true
